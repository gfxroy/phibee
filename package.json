{
  "name": "phibee-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-pty.js",
    "dev": "npm run build && electron .",
