    "node-pty": "^1.0.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
